# Copy this file to .env.local and fill it in. .env.local is git-ignored, so it never gets committed.
# These are the public "web app" settings from the Firebase console (Project settings > Your apps).
# They are not secrets: access is protected by firestore.rules, not by hiding these values.

# --- Option A: practice mode (no real Firebase project touched) ---
# Run `npm run emulators` in one terminal and `npm run dev` in another.
# Only works in `npm run dev`; it is ignored by `npm run build`.
VITE_USE_EMULATORS=true

# --- Option B: the real Firebase project (pitchbookingsystem-6e222) ---
# Do NOT use this during development. Only set VITE_USE_EMULATORS=false after the owner approves the cutover
# (see AGENTS.md section 7), then paste the values from the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
